# =============================================================================
# Home Assistant MCP Server Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Home Assistant Connection (Required)
# -----------------------------------------------------------------------------

# Your Home Assistant URL (must include http:// or https://)
HA_URL=http://homeassistant.10.0.0.19.nip.io:8123

# Long-lived access token from Home Assistant
# Get from: Profile -> Long-Lived Access Tokens
HA_TOKEN=your_long_lived_access_token_here

# Validate SSL certificates (set to false ONLY for self-signed certs or plain HTTP)
# Default: true — keep true in production.
HA_STRICT_SSL=true

# Request timeout in milliseconds
# Default: 30000 (30 seconds)
HA_TIMEOUT=30000

# -----------------------------------------------------------------------------
# AI Provider Configuration (Optional)
# -----------------------------------------------------------------------------

# Provider type: ollama, openai (for OpenAI-compatible APIs), or none (disabled)
AI_PROVIDER=none

# Provider URL
AI_URL=http://ollama.10.0.0.17.nip.io:11434

# Model name
AI_MODEL=qwen3:14b

# Request timeout in milliseconds
AI_TIMEOUT=60000

# API key (optional, for authenticated providers)
# AI_API_KEY=your_api_key_here

# -----------------------------------------------------------------------------
# MCP Server Configuration
# -----------------------------------------------------------------------------

# Log level: debug, info, warn, error
# Default: info
MCP_SERVER_LOG_LEVEL=info

# Log format: plain, json, gcp-json
# - plain: Human-readable format
# - json: Structured JSON logs
# - gcp-json: Google Cloud Platform compatible JSON
# Default: plain
MCP_SERVER_LOG_FORMAT=plain

# Enable HTTP server mode (set to true for web/API access)
# When false, uses stdio mode for Claude Desktop
# Default: false
MCP_SERVER_USE_HTTP=false

# Enable stateful sessions (only for HTTP mode)
# When true, maintains session state across requests
# Default: false
MCP_SERVER_STATEFUL=false

# -----------------------------------------------------------------------------
# HTTP Server Configuration (only when MCP_SERVER_USE_HTTP=true)
# -----------------------------------------------------------------------------

# Port to listen on
# Default: 3000
MCP_HTTP_PORT=3000

# Bind address (use 0.0.0.0 to listen on all interfaces)
# Default: 127.0.0.1 (localhost only)
MCP_HTTP_BIND_ADDR=127.0.0.1

# MCP endpoint path
# Default: /mcp for stream, /sse for SSE
MCP_HTTP_PATH=/mcp

# Enable health check endpoint
# Default: true
MCP_HTTP_ENABLE_HEALTHCHECK=true

# Health check endpoint path
# Default: /health
MCP_HTTP_HEALTHCHECK_PATH=/health

# Enable CORS (Cross-Origin Resource Sharing)
# Default: true
MCP_HTTP_ALLOW_CORS=true

# Allowed origins (comma-separated)
# Use * for all origins (development only!)
# Default: 127.0.0.1,localhost
MCP_HTTP_ALLOWED_ORIGINS=127.0.0.1,localhost,http://mcpserver.10.0.0.18.nip.io:3000

# -----------------------------------------------------------------------------
# Rate Limiting (only when MCP_SERVER_USE_HTTP=true)
# -----------------------------------------------------------------------------

# Enable per-client rate limiting. Default: true
MCP_RATE_LIMIT_ENABLED=true
# Window (ms) and max requests per window. Defaults: 60000 / 100
# MCP_RATE_LIMIT_WINDOW_MS=60000
# MCP_RATE_LIMIT_MAX_REQUESTS=100

# Trusted proxy IPs (comma-separated). Forwarding headers (CF-Connecting-IP,
# X-Forwarded-For, X-Real-IP) are honored ONLY when the immediate peer is listed
# here; otherwise the socket address is used so forged headers cannot evade limits.
# Behind Cloudflare/Docker, set this to the gateway/proxy address that connects to
# the server (e.g. the Docker bridge gateway). Leave empty to key purely on socket.
# MCP_RATE_LIMIT_TRUSTED_PROXIES=172.17.0.1

# -----------------------------------------------------------------------------
# Authentication Configuration (only when MCP_SERVER_USE_HTTP=true)
# -----------------------------------------------------------------------------

# Authentication method: none or bearer
# - none: No authentication. Only permitted on a loopback bind (127.0.0.1/::1).
# - bearer: Require a JWT Bearer token in the Authorization header.
# Default: bearer (secure default; the server refuses none on a public bind).
MCP_AUTH_METHOD=bearer

# JWT signing secret (HS256). REQUIRED when MCP_AUTH_METHOD=bearer.
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
MCP_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional JWT hardening (recommended for production):
# Require tokens to carry an expiry (exp) claim.
# MCP_AUTH_REQUIRE_EXP=true
# Reject tokens whose iss / aud claims do not match.
# MCP_AUTH_ISSUER=mcp-ha-connect
# MCP_AUTH_AUDIENCE=mcp-clients

# =============================================================================
# Security Notes
# =============================================================================
# - Never commit this file with real credentials
# - Use HA_STRICT_SSL=true in production with HTTPS
# - Restrict MCP_HTTP_ALLOWED_ORIGINS to trusted origins (scheme://host:port)
# - Use MCP_HTTP_BIND_ADDR=127.0.0.1 for local-only access
# - Rotate your Home Assistant tokens periodically
# - Keep MCP_AUTH_METHOD=bearer in production; none is loopback-only
# - Issue a distinct JWT per client (with scoped RBAC permissions) for audit
